{
  "manifest_version": 3,
  "name": "ChatGPT Wrangler",
  "version": "1.0.0",
  "description": "Monitor ChatGPT tabs processing status with visual indicators",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": ["tabs", "activeTab", "storage", "scripting", "offscreen"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["settings.js", "chimes.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatGPT Wrangler"
  }
}
